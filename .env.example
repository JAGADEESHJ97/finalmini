# Client-side env vars (public)
VITE_SUPABASE_PROJECT_ID="<your-project-id>"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"

# Development server port (optionally override)
PORT=5173

# -----------------------
# Server-side (Function) env vars - DO NOT COMMIT SECRETS
# For local testing and for Supabase Edge Functions, set the following secret as an environment variable
# SUPABASE_SERVICE_ROLE_KEY: your Supabase service role key (must be kept secret)
# SUPABASE_URL: your Supabase URL (same as VITE_SUPABASE_URL)
